{
  "name": "rescuegrid-ai-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for the RescueGrid AI disaster response hackathon MVP",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node --check src/server.js",
    "db:migrate": "node scripts/database.js migrate",
    "db:seed": "node scripts/database.js seed",
    "verify:response": "node scripts/verify-response-workflow.js",
    "verify:duplicates": "node scripts/verify-duplicate-workflow.js",
    "verify:teams": "node scripts/verify-team-management.js",
    "verify:ai-fallback": "node scripts/verify-ai-fallback.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "^1.28.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "supertest": "^7.1.4",
    "vitest": "^4.0.4"
  }
}
